{
  "name": "@solesius-oss/click-clack-mcp",
  "version": "1.0.8",
  "description": "click-clack coordination hub as a stdio MCP server. Zero-config: `bun add -g @solesius-oss/click-clack-mcp` and point any MCP client at `click-clack-mcp`.",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "click-clack-mcp": "./bin/click-clack-mcp.ts"
  },
  "files": [
    "src",
    "bin",
    "scripts",
    "native",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "build:native": "bun scripts/build-native.ts",
    "prepack": "bun scripts/pack-native.ts",
    "example": "bun examples/hello.ts",
    "test": "bun test"
  },
  "keywords": [
    "click-clack",
    "mcp",
    "model-context-protocol",
    "ffi",
    "agent",
    "coordination",
    "bun"
  ],
  "author": "solesius",
  "license": "MIT",
  "homepage": "https://github.com/Solesius/click-clack#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Solesius/click-clack.git",
    "directory": "bindings/bun"
  },
  "bugs": {
    "url": "https://github.com/Solesius/click-clack/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "cpu": [
    "x64",
    "arm64"
  ]
}
